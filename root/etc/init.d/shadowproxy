#!/bin/sh /etc/rc.common

START=90
STOP=15
USE_PROCD=1

NAME=shadowproxy
CONF_DIR="/etc/$NAME"
RUN_DIR="/var/run/$NAME"
NOFILE_LIMIT="65536"
PROXY_FWMARK="0xfe"
PROXY_TABLE="803"

_info() {
    logger -p 6 -t "$NAME" "$1"
}

_error() {
    logger -p 3 -t "$NAME" "$1"
}

prepare_run_dir() {
    [ -d "$RUN_DIR" ] || mkdir -p -m 0755 "$RUN_DIR"
}

get_tproxy_port() {
    local port
    port="$(uci -q get shadowproxy.@main[0].redir_port)"
    [ -z "$port" ] && port="$(uci -q get shadowproxy.main.redir_port)"
    echo "${port:-60080}"
}

get_dns_port() {
    local port
    port="$(uci -q get shadowproxy.@main[0].dns_port)"
    [ -z "$port" ] && port="$(uci -q get shadowproxy.main.dns_port)"
    echo "${port:-5300}"
}

check_wan_nat() {
    local dev active_devs="" jumpline=""
    
    active_devs=$( (ip -4 route show default 2>/dev/null; ip -6 route show default 2>/dev/null) | sed -n 's/.*dev \([^ ]*\).*/\1/p' | sort -u )

    [ -z "$active_devs" ] && return 0

    for dev in $active_devs; do
        jumpline="$(nft list chain inet fw4 srcnat 2>/dev/null | grep -w "$dev")"
        
        if [ -n "$jumpline" ]; then
            return 0
        fi
    done

    _info "NAT missing for active routing interfaces: $active_devs. Firewall state seems broken."

    if [ -f "/var/run/fw4.lock" ]; then
        _info "fw4 is currently locked, skipping reload to prevent race conditions."
        return 0
    fi

    _info "Triggering asynchronous firewall self-healing for active devices..."
    (fw4 reload >/dev/null 2>&1 || /etc/init.d/firewall reload >/dev/null 2>&1) &
}

generate_config_json() {
    prepare_run_dir
    
    local template_file="$CONF_DIR/config.uc"
    local target_file="$RUN_DIR/config.json"
    
    if [ ! -f "$template_file" ]; then
        _error "ucode script $template_file not found!"
        return 1
    fi

    if ! command -v ucode >/dev/null 2>&1; then
        _error "ucode binary not found! Please install ucode package."
        return 1
    fi

    if ! ucode "$template_file" > "$target_file.tmp" 2>/dev/null; then
        _error "Failed to generate JSON config via ucode AST."
        rm -f "$target_file.tmp"
        return 1
    fi

    if ! eval "$(awk -F'[:=]' '
        /"servers": *\[ *\]/ { empty_servers=1 }
        /"servers": *\[/ { found_servers=1 }
        /"nofile":/ { gsub(/[^0-9]/, "", $2); if ($2 != "") limit=$2 }
        END {
            if (!found_servers || empty_servers) exit 1;
            print "NOFILE_LIMIT=" (limit ? limit : 524288)
        }
    ' "$target_file.tmp" 2>/dev/null)"; then
        _error "No enabled server generated by ucode (or validation failed), aborting."
        rm -f "$target_file.tmp"
        return 1
    fi

    mv -f "$target_file.tmp" "$target_file"
    return 0
}

clear_route() {
    while ip -4 rule del fwmark $PROXY_FWMARK table $PROXY_TABLE 2>/dev/null; do :; done
    ip -4 route flush table $PROXY_TABLE 2>/dev/null || true

    while ip -6 rule del fwmark $PROXY_FWMARK table $PROXY_TABLE 2>/dev/null; do :; done
    ip -6 route flush table $PROXY_TABLE 2>/dev/null || true
}

config_route() {
    clear_route

    ip -4 rule add fwmark $PROXY_FWMARK table $PROXY_TABLE 2>/dev/null
    ip -4 route replace local 0.0.0.0/0 dev lo table $PROXY_TABLE 2>/dev/null

    ip -6 rule add fwmark $PROXY_FWMARK table $PROXY_TABLE 2>/dev/null
    ip -6 route replace local ::/0 dev lo table $PROXY_TABLE 2>/dev/null
}

update_nftables() {
    local atomic_file="$RUN_DIR/shadowproxy_atomic.nft"
    local error_log="$RUN_DIR/nft_error.log"
    local tproxy_port
    prepare_run_dir

    tproxy_port="$(get_tproxy_port)"

    if [ "$tproxy_port" = "0" ] || [ -z "$tproxy_port" ]; then
        _info "redir_port is set to 0 (TPROXY disabled). Cleaning up mangle table and skipping nftables rules."
        nft destroy table inet shadowproxy-mangle 2>/dev/null || true
        rm -f "$atomic_file" "$error_log"
        return 0
    fi

    if [ ! -f "$CONF_DIR/shadowproxy.nft" ]; then
        _error "$CONF_DIR/shadowproxy.nft missing!"
        return 1
    fi

    _info "Applying nftables rules with TPROXY port: ${tproxy_port}"

    {
        echo "table inet shadowproxy-mangle {}"
        echo "delete table inet shadowproxy-mangle"
        cat "$CONF_DIR/shadowproxy.nft"
        
        if [ -f "$CONF_DIR/bypass_ipset.acl" ]; then
            awk '
                /^[^#[:space:]]/ {
                    if ($0 ~ /\./) v4 = (v4 ? v4 ", " : "") $0
                    else if ($0 ~ /:/) v6 = (v6 ? v6 ", " : "") $0
                }
                END {
                    if (v4) print "add element inet shadowproxy-mangle whitelist_v4_set { " v4 " }"
                    if (v6) print "add element inet shadowproxy-mangle whitelist_v6_set { " v6 " }"
                }
            ' "$CONF_DIR/bypass_ipset.acl"
        fi
    } > "$atomic_file"

    if ! nft -f "$atomic_file" -Dtproxy_port="${tproxy_port}" 2>"$error_log"; then
        _error "Failed to load nftables rules atomically! Error details:"
        _error "$(cat "$error_log")"
        return 1
    else
        _info "Nftables rules loaded successfully."
        rm -f "$error_log"
    fi
}

update_proxy_domains() {
    _info "Updating custom proxy domains in RAM..."
    prepare_run_dir
    
    local base_acl="$CONF_DIR/shadowproxy-dns-base.acl"
    local domain_acl="$CONF_DIR/proxy_domains.acl"
    local target_acl="$RUN_DIR/shadowproxy-dns.acl"

    if [ -f "$domain_acl" ]; then
        awk '
        /\{proxy_domains\}/ {
            while ((getline line < domain_file) > 0) {
                sub(/\r$/, "", line)
                if (line ~ /^[^#[:space:]]/) print "||" line
            }
            close(domain_file)
            next
        }
        { print }
        ' domain_file="$domain_acl" "$base_acl" > "$target_acl"
    else
        _info "$domain_acl not found, copying base ACL only."
        cp -f "$base_acl" "$target_acl"
    fi
}

start_shadowproxy() {
    _info "Starting instance with nofile limit derived from config: ${NOFILE_LIMIT}"

    procd_open_instance shadowproxy
    procd_set_param command /usr/bin/sslocal -c "$RUN_DIR/config.json"
    procd_set_param file "$RUN_DIR/config.json"
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-2}
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits nofile="${NOFILE_LIMIT} ${NOFILE_LIMIT}"
    procd_close_instance
}

start_service() {
    local enabled="$(uci -q get shadowproxy.@main[0].enabled)"
    
    if [ "$enabled" = "0" ]; then
        _info "Service shadowproxy is not enabled. Cleaning up..."
        stop_service
        return 0
    fi

    _info "Starting shadowproxy service."

    if [ ! -x "/usr/bin/sslocal" ]; then
        _error "/usr/bin/sslocal does not exist or is not executable, please install it."
        return 1
    fi

    generate_config_json || return 1

    check_wan_nat
    config_route
    update_nftables
    update_proxy_domains
    start_shadowproxy
}

stop_service() {
    _info "Stopping shadowproxy service."
    nft destroy table inet shadowproxy-mangle 2>/dev/null
    clear_route
    rm -rf "$RUN_DIR"/* 2>/dev/null || true
}

service_triggers() {
    procd_add_reload_trigger "shadowproxy"
    
    local iface
    for iface in $(uci -q show network | grep -E '^network\.[a-zA-Z0-9_]+=interface' | cut -d. -f2 | cut -d= -f1); do
        case "$iface" in
            loopback|lan|lan6|docker*)
                ;;
            *)
                procd_add_interface_trigger "interface.*" "$iface" /etc/init.d/shadowproxy reload
                ;;
        esac
    done
}
