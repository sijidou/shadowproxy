define whitelist_v4 = {
    0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10,
    169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
    192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24,
    240.0.0.0/4
}

define whitelist_v6 = {
    ::/128, ::ffff:0:0/96, 2001:db8::/32, fc00::/7, fe80::/10
}

define mark_proxy = 0xfe
define mark_bypass = 0xfd
define mark_ignore = 0xff

#include "/etc/shadowproxy/whitemac"
include "/etc/shadowproxy/chnip4.ips"
include "/etc/shadowproxy/chnip6.ips"

table inet shadowproxy-mangle {

    #set whitemac_set {
    #    typeof ether saddr
    #    elements = $whitemac
    #}

    set whitelist_v4_set {
        typeof ip daddr
        flags interval
        auto-merge
        elements = $whitelist_v4
    }

    set whitelist_v6_set {
        typeof ip6 daddr
        flags interval
        auto-merge
        elements = $whitelist_v6
    }

    set chnip4_set {
        typeof ip daddr
        flags interval
        auto-merge
        elements = $chnip4
    }

    set chnip6_set {
        typeof ip6 daddr
        flags interval
        auto-merge
        elements = $chnip6
    }

    chain bypass_rules {
        ip  daddr @whitelist_v4_set ct mark set $mark_bypass accept
        ip6 daddr @whitelist_v6_set ct mark set $mark_bypass accept
        ip  daddr @chnip4_set       ct mark set $mark_bypass accept
        ip6 daddr @chnip6_set       ct mark set $mark_bypass accept
    }

    chain shadowproxy_input {
        type filter hook prerouting priority mangle; policy accept;
        meta mark $mark_ignore return
        #meta iiftype ether ether saddr != @whitemac_set return
        fib daddr type { local, broadcast, multicast } accept
        fib daddr type { blackhole, unreachable, prohibit } drop
        meta l4proto tcp socket transparent 1 mark set $mark_proxy accept
        ct mark $mark_bypass accept
        ct mark $mark_proxy meta l4proto udp mark set $mark_proxy tproxy to :$tproxy_port accept
        jump bypass_rules
        meta l4proto { tcp, udp } mark set $mark_proxy tproxy to :$tproxy_port ct mark set $mark_proxy accept
    }

    chain shadowproxy_output {
        type route hook output priority mangle; policy accept;
        oifname "lo" return
        meta mark $mark_ignore return
        fib daddr type { local, broadcast, multicast } accept
        fib daddr type { blackhole, unreachable, prohibit } drop
        ct mark $mark_bypass accept
        ct mark $mark_proxy mark set $mark_proxy accept
        jump bypass_rules
        meta l4proto { tcp, udp } mark set $mark_proxy ct mark set $mark_proxy accept
    }
}
